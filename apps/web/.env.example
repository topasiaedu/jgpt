# Server-only. Never expose to the browser.
# Place this file at apps/web/.env.local (Next loads env from the app directory).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Module/tool chat ask-match QA (second call after primary reply). Default on.
# OPENAI_QA_ENABLED=0
# Judge model (cheaper/faster). Repair reuses OPENAI_MODEL. Default: gpt-4.1-nano
# OPENAI_QA_MODEL=gpt-4.1-nano

# Supabase (Jeff GPT project). Public URL + anon/publishable key are safe for the browser.
# Dashboard: Project Settings → API. Project URL example: https://lizrtckbhfswyrokiawd.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Auth redirect URLs (Dashboard → Authentication → URL Configuration):
# - Site URL: your app origin (local: http://localhost:3000)
# - Redirect URLs (allow list), add both local and production:
#   http://localhost:3000/auth/callback
#   http://localhost:3000/auth/confirm
#   http://localhost:3000/auth/reset
#   https://YOUR_DOMAIN/auth/callback
#   https://YOUR_DOMAIN/auth/confirm
#   https://YOUR_DOMAIN/auth/reset
# Password reset emails use redirectTo → /auth/callback?next=/auth/reset (PKCE).
# Optional custom Recovery template link:
#   {{ .SiteURL }}/auth/confirm?token_hash={{ .TokenHash }}&type=recovery&next=/auth/reset


# Server-only. Required for Brand document ingest (upload process + re-summarize).
# Dashboard: Project Settings → API → service_role (secret). Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
