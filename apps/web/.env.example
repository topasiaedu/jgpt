# Server-only. Never expose to the browser.
# Place this file at apps/web/.env.local (Next loads env from the app directory).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Module/tool chat ask-match QA (second call after primary reply). Default on.
# OPENAI_QA_ENABLED=0
# Judge model (cheaper/faster). Repair reuses OPENAI_MODEL. Default: gpt-4.1-nano
# OPENAI_QA_MODEL=gpt-4.1-nano
